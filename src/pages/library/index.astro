---
import Layout from "@/layouts/layout.astro";
import { Image } from "astro:assets";
import { env } from "cloudflare:workers";
import { drizzle } from "drizzle-orm/d1";
import { eq, desc, count } from "drizzle-orm";
import { formatDistanceToNow } from "date-fns";
import * as schema from "@/db/schema";
import { formatDate } from "@/lib/utils";
import { formatImageUrl } from "@/lib/file";
import { RemoveLibraryButton } from "@/components/remove-library-button";
import {
  RemoveHistoryButton,
  ClearHistoryButton,
} from "@/components/remove-history-button";
import { LibraryAuthGate } from "@/components/library-auth-gate";

const session = Astro.locals.session;
const user = Astro.locals.user;
const isAuthed = !!(session && user);

const url = new URL(Astro.request.url);
const tabParam = url.searchParams.get("tab");
const activeTab = tabParam === "history" ? "history" : "saved";
const currentPage = Math.max(
  1,
  parseInt(url.searchParams.get("page") || "1", 10),
);
const pageSize = 20;

const getTabUrl = (tab: "saved" | "history", page = 1) => {
  const next = new URL(url);
  next.searchParams.set("tab", tab);
  if (page <= 1) next.searchParams.delete("page");
  else next.searchParams.set("page", String(page));
  return next.pathname + next.search;
};

const getPageUrl = (page: number) => getTabUrl(activeTab, page);

Astro.response.headers.set(
  "Cache-Control",
  "private, no-cache, no-store, must-revalidate",
);

const r2Domain = env.R2_DOMAIN;
let totalItems = 0;
let totalPages = 1;
let userLibrary: {
  novel: typeof schema.novel.$inferSelect;
  addedAt: Date;
}[] = [];
let historyItems: {
  novel: typeof schema.novel.$inferSelect;
  chapterNumber: number;
  chapterTitle: string;
  updatedAt: Date;
}[] = [];

if (isAuthed && user) {
  const db = drizzle(env.DB, { schema });

  if (activeTab === "saved") {
    const [{ value }] = await db
      .select({ value: count() })
      .from(schema.userLibrary)
      .where(eq(schema.userLibrary.userId, user.id));
    totalItems = value;
    totalPages = Math.max(1, Math.ceil(totalItems / pageSize));

    userLibrary = await db
      .select({
        novel: schema.novel,
        addedAt: schema.userLibrary.createdAt,
      })
      .from(schema.userLibrary)
      .innerJoin(schema.novel, eq(schema.userLibrary.novelId, schema.novel.id))
      .where(eq(schema.userLibrary.userId, user.id))
      .orderBy(desc(schema.userLibrary.createdAt))
      .limit(pageSize)
      .offset((currentPage - 1) * pageSize);
  } else {
    const [{ value }] = await db
      .select({ value: count() })
      .from(schema.userReadingProgress)
      .where(eq(schema.userReadingProgress.userId, user.id));
    totalItems = value;
    totalPages = Math.max(1, Math.ceil(totalItems / pageSize));

    historyItems = await db
      .select({
        novel: schema.novel,
        chapterNumber: schema.userReadingProgress.chapterNumber,
        chapterTitle: schema.userReadingProgress.chapterTitle,
        updatedAt: schema.userReadingProgress.updatedAt,
      })
      .from(schema.userReadingProgress)
      .innerJoin(
        schema.novel,
        eq(schema.userReadingProgress.novelId, schema.novel.id),
      )
      .where(eq(schema.userReadingProgress.userId, user.id))
      .orderBy(desc(schema.userReadingProgress.updatedAt))
      .limit(pageSize)
      .offset((currentPage - 1) * pageSize);
  }
}
---

<Layout title="My Library — Wuxia Dreams">
  {
    !isAuthed ? (
      <main class="mx-auto max-w-md px-4 py-16">
        <LibraryAuthGate client:load />
      </main>
    ) : (
      <main class="mx-auto max-w-6xl px-4 py-12">
        <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h1 class="text-3xl font-bold tracking-tight">My Library</h1>
            <p class="mt-2 text-muted-foreground">
              Saved novels and where you left off.
            </p>
          </div>
          {activeTab === "history" && historyItems.length > 0 && (
            <ClearHistoryButton client:load />
          )}
        </div>

        <div class="mb-8 flex items-center gap-1 rounded-xl border border-border/60 bg-muted/30 p-1 w-fit">
          <a
            href={getTabUrl("saved")}
            class:list={[
              "rounded-lg px-4 py-2 text-sm font-medium transition",
              activeTab === "saved"
                ? "bg-background text-foreground shadow-sm"
                : "text-muted-foreground hover:text-foreground",
            ]}
          >
            Saved
          </a>
          <a
            href={getTabUrl("history")}
            class:list={[
              "rounded-lg px-4 py-2 text-sm font-medium transition",
              activeTab === "history"
                ? "bg-background text-foreground shadow-sm"
                : "text-muted-foreground hover:text-foreground",
            ]}
          >
            History
          </a>
        </div>

        {activeTab === "saved" ? (
          userLibrary.length > 0 ? (
            <div class="grid gap-4 sm:gap-6 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
              {userLibrary.map(({ novel, addedAt }) => (
                <div class="group relative flex flex-col overflow-hidden rounded-2xl border border-border/70 bg-card shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                  <div class="absolute right-2 top-2 z-20">
                    <RemoveLibraryButton
                      client:load
                      novelId={novel.id}
                      novelTitle={novel.title}
                    />
                  </div>
                  <a href={`/novel/${novel.slug}`} class="flex h-full flex-col">
                    <div class="aspect-2/3 w-full overflow-hidden bg-muted relative">
                      <div class="absolute left-2 top-2 z-10">
                        <span
                          class={`inline-flex items-center rounded-full border border-transparent px-2.5 py-0.5 text-[10px] font-semibold lowercase tracking-wider shadow backdrop-blur-sm ${novel.status === "ongoing" ? "bg-chart-4/90 text-zinc-950" : "bg-primary/90 text-primary-foreground"}`}
                        >
                          {novel.status}
                        </span>
                      </div>
                      {novel.cover ? (
                        <Image
                          src={formatImageUrl(
                            r2Domain,
                            novel.cover,
                            novel.updatedAt,
                          )}
                          alt={novel.title}
                          width={200}
                          height={300}
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                        />
                      ) : (
                        <div class="flex h-full w-full items-center justify-center text-muted-foreground">
                          No cover
                        </div>
                      )}
                    </div>
                    <div class="flex flex-1 flex-col p-4">
                      <h3 class="line-clamp-2 text-base font-semibold leading-tight group-hover:text-primary transition-colors">
                        {novel.title}
                      </h3>
                      <div class="mt-2 text-xs text-muted-foreground flex items-center">
                        <span>{novel.chapterCount} Chapters</span>
                      </div>
                      <div class="mt-auto pt-3 flex items-center justify-between text-xs text-muted-foreground">
                        <span>{novel.viewCount.toLocaleString()} views</span>
                        <span>{novel.score.toFixed(1)}</span>
                      </div>
                      <div class="mt-2 text-[11px] text-muted-foreground/70 border-t border-border/40 pt-2">
                        Added on {formatDate(addedAt)}
                      </div>
                    </div>
                  </a>
                </div>
              ))}
            </div>
          ) : (
            <div class="flex flex-col items-center justify-center rounded-3xl border border-dashed border-border/60 py-24 text-center">
              <h3 class="text-lg font-semibold">Your library is empty</h3>
              <p class="mt-2 text-sm text-muted-foreground max-w-sm">
                You haven't saved any novels yet. Browse to find something to
                read.
              </p>
              <a
                href="/novels"
                class="mt-6 inline-flex h-10 items-center justify-center rounded-xl bg-primary px-4 text-sm font-semibold text-primary-foreground transition hover:bg-primary/90"
              >
                Browse Novels
              </a>
            </div>
          )
        ) : historyItems.length > 0 ? (
          <div class="grid gap-4 sm:gap-6 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
            {historyItems.map(
              ({ novel, chapterNumber, chapterTitle, updatedAt }) => (
                <div class="group relative flex flex-col overflow-hidden rounded-2xl border border-border/70 bg-card shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                  <div class="absolute right-2 top-2 z-20">
                    <RemoveHistoryButton
                      client:load
                      novelId={novel.id}
                      novelTitle={novel.title}
                    />
                  </div>
                  <a
                    href={`/novel/${novel.slug}/chapter-${chapterNumber}`}
                    class="flex h-full flex-col"
                  >
                    <div class="aspect-2/3 w-full overflow-hidden bg-muted relative">
                      {novel.cover ? (
                        <Image
                          src={formatImageUrl(
                            r2Domain,
                            novel.cover,
                            novel.updatedAt,
                          )}
                          alt={novel.title}
                          width={200}
                          height={300}
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                        />
                      ) : (
                        <div class="flex h-full w-full items-center justify-center text-muted-foreground">
                          No cover
                        </div>
                      )}
                    </div>
                    <div class="flex flex-1 flex-col p-4">
                      <h3 class="line-clamp-2 text-base font-semibold leading-tight group-hover:text-primary transition-colors">
                        {novel.title}
                      </h3>
                      <p class="mt-2 line-clamp-2 text-xs text-muted-foreground">
                        Ch. {chapterNumber}
                        {chapterTitle ? ` · ${chapterTitle}` : ""}
                      </p>
                      <div class="mt-auto pt-3 text-[11px] text-muted-foreground/70 border-t border-border/40">
                        {formatDistanceToNow(
                          updatedAt instanceof Date
                            ? updatedAt
                            : new Date(updatedAt),
                          { addSuffix: true },
                        )}
                      </div>
                      <span class="mt-2 text-xs font-semibold text-primary">
                        Continue →
                      </span>
                    </div>
                  </a>
                </div>
              ),
            )}
          </div>
        ) : (
          <div class="flex flex-col items-center justify-center rounded-3xl border border-dashed border-border/60 py-24 text-center">
            <h3 class="text-lg font-semibold">No reading history yet</h3>
            <p class="mt-2 text-sm text-muted-foreground max-w-sm">
              Open a chapter and we'll remember where you left off.
            </p>
            <a
              href="/novels"
              class="mt-6 inline-flex h-10 items-center justify-center rounded-xl bg-primary px-4 text-sm font-semibold text-primary-foreground transition hover:bg-primary/90"
            >
              Browse Novels
            </a>
          </div>
        )}

        {totalPages > 1 && (
          <div class="mt-12 flex items-center justify-center gap-2">
            <a
              href={getPageUrl(Math.max(1, currentPage - 1))}
              class:list={[
                "inline-flex h-10 items-center justify-center rounded-xl border border-border/70 bg-card px-4 text-sm font-medium transition hover:bg-muted",
                currentPage === 1 && "pointer-events-none opacity-50",
              ]}
            >
              Previous
            </a>
            <div class="text-sm text-muted-foreground mx-4">
              Page{" "}
              <span class="font-semibold text-foreground">{currentPage}</span> of{" "}
              {totalPages}
            </div>
            <a
              href={getPageUrl(Math.min(totalPages, currentPage + 1))}
              class:list={[
                "inline-flex h-10 items-center justify-center rounded-xl border border-border/70 bg-card px-4 text-sm font-medium transition hover:bg-muted",
                currentPage === totalPages && "pointer-events-none opacity-50",
              ]}
            >
              Next
            </a>
          </div>
        )}
      </main>
    )
  }
</Layout>
