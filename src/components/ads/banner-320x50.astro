---
import { cn } from "@/lib/utils";

const { className } = Astro.props;
---

<div class={cn("w-full flex items-center justify-center", className)}>
  <div data-ad-slot-320x50></div>
</div>

<script is:inline data-astro-rerun>
  function queueAdLoad(slot, atOptions, src) {
    const w = window;
    if (!w.__adInvokeQueue) {
      w.__adInvokeQueue = Promise.resolve();
    }

    w.__adInvokeQueue = w.__adInvokeQueue.then(
      () =>
        new Promise((resolve) => {
          slot.innerHTML = "";
          w.atOptions = atOptions;

          const adScript = document.createElement("script");
          adScript.type = "text/javascript";
          adScript.async = true;
          adScript.src = src;
          adScript.onload = () => resolve();
          adScript.onerror = () => resolve();

          slot.appendChild(adScript);
        }),
    );
  }

  function loadBanner320x50() {
    const slots = document.querySelectorAll("[data-ad-slot-320x50]");

    slots.forEach((slot) => {
      queueAdLoad(
        slot,
        {
          key: "71dd015fae4f5f1b0c54b57a9e5279f2",
          format: "iframe",
          height: 50,
          width: 320,
          params: {},
        },
        "https://www.highperformanceformat.com/71dd015fae4f5f1b0c54b57a9e5279f2/invoke.js",
      );
    });
  }

  loadBanner320x50();
</script>
