---
import { cn } from "@/lib/utils";

const { class: classProp, className, mediaQuery } = Astro.props;
const shouldLoadAds = import.meta.env.PROD;
---

{
  shouldLoadAds && (
    <>
      <div class={cn("w-full not-prose", classProp, className)}>
        <div
          class="flex w-full justify-center"
          data-ad-slot-300x250
          data-ad-media-query={mediaQuery}
        />
      </div>

      <script is:inline data-astro-rerun>
        function queueAdLoad(slot, atOptions, src) {
          const w = window;
          if (!w.__adInvokeQueue) {
            w.__adInvokeQueue = Promise.resolve();
          }

          w.__adInvokeQueue = w.__adInvokeQueue.then(
            () =>
              new Promise((resolve) => {
                slot.innerHTML = "";
                w.atOptions = atOptions;

                const adScript = document.createElement("script");
                adScript.type = "text/javascript";
                adScript.async = true;
                adScript.src = src;
                adScript.onload = () => resolve();
                adScript.onerror = () => resolve();

                slot.appendChild(adScript);
              }),
          );
        }

        function loadBanner300x250() {
          const slots = document.querySelectorAll("[data-ad-slot-300x250]");

          slots.forEach((slot) => {
            const query = slot.getAttribute("data-ad-media-query");
            if (query && !window.matchMedia(query).matches) {
              slot.innerHTML = "";
              return;
            }

            queueAdLoad(
              slot,
              {
                key: "ad823167462130ac6a61c7aed37ea2a2",
                format: "iframe",
                height: 250,
                width: 300,
                params: {},
              },
              "https://www.highperformanceformat.com/ad823167462130ac6a61c7aed37ea2a2/invoke.js",
            );
          });
        }

        loadBanner300x250();
      </script>
    </>
  )
}
