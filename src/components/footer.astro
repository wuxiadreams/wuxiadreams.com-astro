---
import { AuthDialog } from "@/components/auth-dialog";
import { Image } from "astro:assets";
import FooterDynamic from "./footer-dynamic.astro";

const year = new Date().getFullYear();
const columns = [
  {
    title: "Explore",
    links: [
      { href: "/novels", label: "Novels" },
      { href: "/rankings", label: "Rankings" },
      { href: "/authors", label: "Authors" },
      { href: "/genres", label: "Genres" },
      { href: "/tags", label: "Tags" },
      { href: "/posts", label: "Articles" },
    ],
  },
  {
    title: "Teams",
    links: [
      { href: "/about", label: "About" },
      { href: "mailto:wuxiadreams@gmail.com", label: "Contact" },
      {
        href: "https://discord.gg/6eUYFJJMnE",
        label: "Feedback",
        external: true,
      },
    ],
  },
];

const discordUrl = "https://discord.gg/6eUYFJJMnE";
---

<footer class="border-t border-border/60 bg-background">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-10 md:grid-cols-[1.2fr_2fr]">
      <div>
        <div class="flex items-center gap-3">
          <Image
            src="/logo.png"
            alt="Wuxia Dreams"
            width={36}
            height={36}
            class="h-9 w-9 rounded-md ring-1 ring-border/70"
            loading="lazy"
          />
          <div>
            <div class="text-base font-semibold tracking-tight">
              Wuxia Dreams
            </div>
            <div class="text-xs tracking-[0.22em] text-muted-foreground">
              READ · TRACK · DISCOVER
            </div>
          </div>
        </div>

        <p class="mt-4 max-w-sm text-sm leading-relaxed text-muted-foreground">
          A focused fiction hub built for discovery and tracking. Find your next
          read fast, then keep your progress under control.
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          <FooterDynamic server:defer>
            <AuthDialog
              slot="fallback"
              client:only
              triggerText="Sign in / Start tracking"
              triggerClassName="inline-flex h-10 cursor-pointer items-center justify-center rounded-xl bg-primary px-4 text-sm font-semibold text-primary-foreground shadow-sm transition hover:bg-primary/90"
              subtitle="Keep reading where you left off on any device"
            />
          </FooterDynamic>
          <a
            href="/novels"
            class="inline-flex h-10 items-center justify-center rounded-xl border border-border/70 bg-background px-4 text-sm font-semibold text-foreground shadow-sm transition hover:bg-muted"
          >
            Browse novels
          </a>
        </div>

        <a
          href={discordUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 flex max-w-sm items-start gap-3 rounded-2xl border border-border/70 bg-card/60 p-4 transition hover:border-[#5865F2]/50 hover:bg-[#5865F2]/10"
        >
          <span
            class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#5865F2] text-white"
            aria-hidden="true"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
              ></path>
            </svg>
          </span>
          <span class="min-w-0">
            <span class="block text-sm font-semibold text-foreground">
              Join our Discord
            </span>
            <span class="mt-0.5 block text-xs leading-relaxed text-muted-foreground">
              Request novels, share feedback, and chat with fellow readers.
            </span>
          </span>
        </a>
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        {
          columns.map((col) => (
            <div>
              <div class="text-sm font-semibold text-foreground">
                {col.title}
              </div>
              <div class="mt-3 grid gap-2">
                {col.links.map((link) => (
                  <a
                    href={link.href}
                    class="text-sm text-muted-foreground transition hover:text-foreground"
                    {...("external" in link && link.external
                      ? {
                          target: "_blank",
                          rel: "noopener noreferrer",
                        }
                      : {})}
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="mt-10 flex flex-col gap-3 border-t border-border/60 pt-6 text-sm text-muted-foreground md:flex-row md:items-center md:justify-between"
    >
      <div>© {year} Wuxia Dreams. All rights reserved.</div>
      <div class="flex flex-wrap gap-x-4 gap-y-2">
        <a
          href={discordUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-foreground"
        >
          Discord
        </a>
        <a href="/privacy-policy" class="hover:text-foreground">Privacy</a>
        <a href="/terms-of-service" class="hover:text-foreground">Terms</a>
        <a href="/dmca" class="hover:text-foreground">DMCA</a>
      </div>
    </div>
  </div>
</footer>
